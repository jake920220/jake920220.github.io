---
import { humanize, slugify } from "@/lib/utils/textConverter";

type Props = {
  name: string;
  count?: number;
  size?: "sm" | "md" | "lg";
  active?: boolean;
  href?: string;
  showHash?: boolean;
  className?: string;
};

const {
  name,
  count,
  size = "md",
  active = false,
  href,
  showHash = true,
  className = "",
} = Astro.props;

const slug = slugify(name);
const targetHref = href || `/tags/${slug}`;

// Size variants
const sizeClasses = {
  sm: "px-2.5 py-1 text-xs gap-1.5",
  md: "px-3.5 py-1.5 text-xs sm:text-sm gap-2",
  lg: "px-4 py-2 text-sm sm:text-base gap-2.5",
};

// Base styling with proper light and dark mode colors
const baseClass = "inline-flex items-center rounded-full font-medium transition-all duration-200";

const activeClass = active
  ? "bg-primary text-white shadow-sm border border-primary font-semibold"
  : "border border-slate-200 bg-slate-100/80 text-slate-700 hover:bg-slate-200/90 hover:text-slate-900 hover:border-slate-300 dark:border-slate-700/80 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:hover:text-white dark:hover:border-slate-600";
---

<a
  href={targetHref}
  class=`${baseClass} ${sizeClasses[size]} ${activeClass} ${className}`
>
  {showHash && <span class={active ? "text-white/80" : "text-slate-400 dark:text-slate-500 text-[0.9em]"}>#</span>}
  <span>{name.toLowerCase() === "all" ? "All" : humanize(name)}</span>
  {
    typeof count === "number" && (
      <span
        class={
          active
            ? "inline-flex items-center justify-center rounded-full bg-white/20 px-1.5 py-0.2 text-[0.8em] font-semibold text-white"
            : "inline-flex items-center justify-center rounded-full bg-slate-200/80 dark:bg-slate-700 px-1.5 py-0.2 text-[0.8em] font-semibold text-slate-600 dark:text-slate-300"
        }
      >
        {count}
      </span>
    )
  }
</a>
