const philosophies = [
  {
    title: "유지보수 가능한 구조",
    desc: "당장 빠르게 동작하는 코드와 시간이 지나도 수정할 수 있는 코드는 다릅니다. 복잡성을 숨기기보다 줄이고, 변경의 영향 범위를 예측할 수 있는 구조를 만듭니다.",
    icon: "🏗️",
