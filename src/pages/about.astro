    icon: "🤖",
  },
];

const blogTopics = [
  { title: "Frontend Engineering", desc: "React, Next.js, TypeScript와 프론트엔드 아키텍처" },
  { title: "Agentic Engineering", desc: "AI Coding Agent, Agentic Coding, Context Engineering과 AI 시대의 개발 워크플로우" },
  { title: "AI & AX", desc: "생성형 AI와 AI Agent를 실제 개발 및 업무 프로세스에 적용하는 방법" },
  { title: "Teaching", desc: "개발자 교육과 기업교육을 준비하며 다시 공부하고 구조화한 기술" },
  { title: "Problem Solving", desc: "실무와 프로젝트에서 만난 문제와 해결 과정" },
  { title: "Tools & Productivity", desc: "개발과 지식 노동의 반복 작업을 줄이는 도구와 자동화" },
];

const techSkills = {
  "Frontend": ["React", "Next.js", "TypeScript", "JavaScript", "React Native", "Tailwind CSS", "TanStack Query", "Zustand", "Redux"],
  "AI / Agentic Engineering": ["Claude Code", "Codex", "AI Coding Agents", "Agentic Coding", "Prompt Engineering", "Context Engineering", "Spec-Driven Development"],
  "Platform / Operations": ["Sentry", "Google Analytics", "AppCenter", "Vercel", "Android", "iOS", "WebView"],
  "Experienced": ["Vue.js", "AngularJS", "Gatsby", "Node.js", "Express", "Koa", "MySQL", "MariaDB", "MongoDB"],
};
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  canonical={canonical}
  jsonLd={jsonLd}
>
  {/* Hero Section */}
  <section class="section pb-8">
    <div class="container">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-10 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="row gy-8 items-center">
          <div class="col-12 sm:col-5 md:col-4 text-center sm:text-left">
            {
              image && (
                <div class="relative inline-block">
                  <Image
                    src={image}
                    width={360}
                    height={360}
                    alt={title}
                    class="rounded-2xl w-full max-w-[280px] sm:max-w-full mx-auto object-cover shadow-md border border-slate-200 dark:border-slate-700"
                  />
                  <div class="absolute -bottom-3 -right-3 rounded-xl bg-primary px-3 py-1 text-xs font-bold text-white shadow-md">
                    7+ Years Exp.
                  </div>
                </div>
              )
            }
          </div>

          <div class="col-12 sm:col-7 md:col-8">
            <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-semibold text-primary mb-3">
              <HiSparkles className="text-sm" />
              <span>프론트엔드 엔지니어 & 기술 강사</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white leading-snug mb-4">
              안녕하세요.<br class="hidden sm:inline" /> 프론트엔드 개발자이자 기술 강사 김준현입니다.
            </h1>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-4 text-base sm:text-lg">
              “준현의 기록”은 <strong>개발하고, 가르치고, AI와 함께 일하는 새로운 방식을 탐구하는</strong> 기술 블로그입니다.
            </p>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6 text-sm sm:text-base">
              7년간 웹과 앱 서비스를 개발하며 프론트엔드 엔지니어링 경험을 쌓았고, 이후 KDT 개발 교육과 기업교육으로 활동 영역을 확장해왔습니다.
              React, Next.js, TypeScript를 중심으로 한 프론트엔드 개발을 기반으로 현재는 <strong>AI Coding Agent, Agentic Coding, Context Engineering과 AX(AI Transformation)</strong>에 관심을 두고 개발과 교육 양쪽에서 경험을 쌓고 있습니다.
            </p>

            {/* Quick Contact & Socials */}
            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a
                href="mailto:kimjun8jun8@gmail.com"
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary/90 hover:shadow"
              >
                <FaEnvelope />
                <span>Contact Me</span>
              </a>
              <a
                href="https://github.com/jake920220"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
              >
                <FaGithub />
                <span>GitHub</span>
              </a>
              <a
                href="https://www.linkedin.com/in/linokim/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
              >
                <FaLinkedin />
                <span>LinkedIn</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* What I Do Section */}
  <section class="section py-8">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="h2 mb-3">무엇을 하고 있나요</h2>
        <p class="text-text">실무 엔지니어링, 기술 교육, AI 연구 및 지식 체계화 4가지 축으로 활동합니다.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* 1. Frontend */}
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-2xl dark:bg-blue-900/30">🧩</span>
              <h3 class="text-xl font-bold">프론트엔드 엔지니어링</h3>
            </div>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm mb-4">
              React, Next.js, React Native를 중심으로 웹과 모바일 서비스를 개발해왔습니다. 단순한 화면 구현보다 실제 서비스가 운영되는 과정에서 발생하는 문제를 해결하는 것에 집중합니다.
            </p>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm">
              레거시 프로젝트 재구축, 주문·결제 시스템, 관리자 도구, 모바일 WebView, 외부 디바이스 연동, 오류 모니터링과 사용자 행동 분석 등 제품의 개발부터 운영까지 다양한 문제를 경험했습니다.
            </p>
          </div>
        </div>

        {/* 2. Education */}
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-purple-50 text-2xl dark:bg-purple-900/30">🎓</span>
              <h3 class="text-xl font-bold">개발 교육 & 기업교육</h3>
            </div>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm mb-4">
              프론트엔드 실무 경험을 바탕으로 개발자를 교육하고, 최근에는 AI·AX를 주제로 한 기업교육으로 활동 영역을 넓히고 있습니다.
            </p>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm">
              JS/TS, React, Next.js 웹 개발 기술부터 Claude Code를 비롯한 AI Coding Agent, 바이브코딩, Agentic Coding, 생성형 AI와 AX 교육을 진행하며 비개발자가 AI를 이용해 직접 업무 방식을 혁신하도록 돕습니다.
            </p>
          </div>
        </div>

        {/* 3. AI & Agentic */}
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-2xl dark:bg-emerald-900/30">🤖</span>
              <h3 class="text-xl font-bold">AI · AX · Agentic Coding</h3>
            </div>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm mb-4">
              AI가 소프트웨어를 만드는 과정과 지식 노동의 방식 자체를 변화시키고 있습니다. 요구사항 정의, 컨텍스트 설계, 문서 기반 개발, 코드 생성, 테스트, 리뷰와 검증을 하나의 프로세스로 연결합니다.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {aiTopics.map((topic) => (
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {topic}
                </span>
              ))}
            </div>
          </div>
        </div>

        {/* 4. Notes */}
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-2xl dark:bg-amber-900/30">✍️</span>
              <h3 class="text-xl font-bold">기록 & 지식 체계화</h3>
            </div>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm mb-4">
              개발하면서 알게 된 사실보다 <strong>왜 그런 판단을 했는지</strong>를 남기려고 합니다.
            </p>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm">
              문제를 해결했던 과정, 기술 선택의 이유, 실패했던 접근, 강의를 준비하며 다시 공부하게 된 개념, AI와 함께 개발하면서 변화한 작업 방식까지 나중에 다시 꺼내 사용할 수 있는 지식으로 정리합니다.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Bio Story Section */}
  <section class="section py-8">
    <div class="container">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-10 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="h3 mb-6 pb-3 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
          <span>저를 소개합니다</span>
        </h2>
        <div class="content about-content text-slate-700 dark:text-slate-300 leading-relaxed space-y-4">
          <Content />
        </div>
      </div>
    </div>
  </section>

  {/* Teaching Career Section (High Priority) */}
  <section class="section py-8">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3.5 py-1 text-xs font-semibold text-primary mb-2">
          <HiAcademicCap className="text-base" />
          <span>Teaching Career</span>
        </div>
        <h2 class="h2 mb-3">교육 및 강의 이력</h2>
        <p class="text-text">국내 주요 대기업 대상 AI·AX 기업교육 및 KDT 부트캠프 개발자 양성 교육 이력입니다.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {/* Corporate Teaching */}
        <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-xl text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
              <BiBuilding />
            </span>
            <div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">AI · AX 기업교육</h3>
              <p class="text-xs text-slate-500">대기업 임직원 및 사업부 대상 기술 교육 / 튜터링</p>
            </div>
          </div>

          <div class="space-y-4">
            {
              corporateTeaching.map((item) => (
                <div class="rounded-xl bg-slate-50 p-4 transition hover:bg-indigo-50/40 dark:bg-slate-800/60 dark:hover:bg-slate-800">
                  <div class="font-bold text-base text-slate-900 dark:text-white mb-2 flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-indigo-500"></span>
