---
import Base from "@/layouts/Base.astro";
import TagItem from "@/components/TagItem.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { slugify } from "@/lib/utils/textConverter";

const posts = await getSinglePage("posts");

// Count posts per tag
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  (post.data.tags || []).forEach((tag: string) => {
    const slug = slugify(tag);
    if (slug) {
      tagCounts[slug] = (tagCounts[slug] || 0) + 1;
    }
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Base
  title={"Tags"}
  meta_title={"태그 목록 | 준현의 기록 (기술 블로그)"}
  description={"기술 블로그의 주제별 태그 목록입니다. 원하는 키워드로 관련된 개발 및 엔지니어링 글을 탐색해보세요."}
>
  <section class="section">
    <div class="container text-center max-w-3xl mx-auto">
      <h1 class="h2 page-heading mb-4">Tags</h1>
      <p class="text-text mb-10">관심 있는 주제의 태그를 선택하여 관련 기술 글을 탐색해보세요.</p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        {
          sortedTags.map(([tag, count]) => (
            <TagItem name={tag} count={count} size="lg" />
          ))
        }
      </div>
    </div>
  </section>
</Base>


